+/// (Mutex/AtomicBool) at every usage site — this wrapper does NOT provide
+/// synchronization itself.
 pub struct UnsafeCellWrapper<T: ?Sized>(UnsafeCell<T>);
 
 impl<T> UnsafeCellWrapper<T> {
